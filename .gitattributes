# Normalize all text files to LF on commit; check out LF on every platform.
* text=auto eol=lf

# Explicit text types (kept LF even if the heuristics misfire)
*.rs       text eol=lf
*.ts       text eol=lf
*.js       text eol=lf
*.svelte   text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.proto    text eol=lf
*.py       text eol=lf
*.pyi      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.sh       text eol=lf

# Windows scripts keep CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary assets — never normalized, never diffed as text
*.png      binary
*.ico      binary
*.icns     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.wav      binary
*.mp3      binary
*.flac     binary
*.onnx     binary

# Git LFS — large binary fixtures (Hebrew/English audio corpora) and any model
# weights that ever land in-tree. Vendored fonts stay regular binaries (small).
tests/**/*.wav          filter=lfs diff=lfs merge=lfs -text
tests/**/*.mp3          filter=lfs diff=lfs merge=lfs -text
tests/**/*.flac         filter=lfs diff=lfs merge=lfs -text
models/**/*.onnx        filter=lfs diff=lfs merge=lfs -text
models/**/*.gguf        filter=lfs diff=lfs merge=lfs -text
models/**/*.bin         filter=lfs diff=lfs merge=lfs -text
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
